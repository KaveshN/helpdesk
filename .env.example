# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env -- it is in .gitignore.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Host value for running the app on the host machine against the compose DB.
# Inside docker compose the app service overrides the host to `db`.
# Schema owner: used only by the Prisma CLI (migrate, studio) and the seed.
# The app never connects as the owner -- owners bypass row-level security.
DATABASE_ADMIN_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public
# Runtime login: a member of helpdesk_platform (and through it helpdesk_app).
# Created by docker/postgres-init/02-runtime-roles.sql on a fresh cluster.
DATABASE_URL=postgresql://helpdesk_runtime:helpdesk@localhost:5432/helpdesk?schema=public
# Prisma Migrate needs a throwaway DB to diff against. Same server is fine.
SHADOW_DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk_shadow?schema=public

# --- Redis (sessions + session revocation + active-group context) ---------
REDIS_URL=redis://localhost:6379

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3001
# Trust the X-Forwarded-* headers from a reverse proxy / ingress.
AUTH_TRUST_HOST=true

# --- Microsoft Entra ID (Azure AD) OIDC -----------------------------------
# App registration -> Overview for the IDs, Certificates & secrets for the value.
# Redirect URI to register: http://localhost:3001/api/auth/callback/microsoft-entra-id
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Dev-only login ------------------------------------------------------
# Enables an email-only credentials provider so the app is usable before Entra
# is wired up. HARD-REFUSED when NODE_ENV=production (see src/lib/auth/config.ts).
AUTH_DEV_LOGIN=true

# --- Bootstrap ------------------------------------------------------------
# Comma-separated. These addresses are granted SUPER_ADMIN by the seed script
# and promoted on first login if they sign in via Entra.
SUPER_ADMIN_EMAILS=superadmin@example.com

# --- Observability -------------------------------------------------------
LOG_LEVEL=info

# --- Outbound email (Phase 2) --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Help Desk <helpdesk@example.com>"

# --- Inbound email-to-ticket (Phase 6, worker stub) ----------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_INTERVAL_SECONDS=60
